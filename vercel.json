{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "./",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "cas", "format": "url", "env": "CAS_SERVICE_URL" }]
    },
    "cas": {
      "root": "cas/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
