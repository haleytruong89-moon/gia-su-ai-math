# Supabase (cùng project study-launcher; cùng giá trị như Launcher)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only

# Anthropic — workspace + key RIÊNG cho gia sư AI (D19). Server only.
ANTHROPIC_API_KEY=
TUTOR_MODEL_MAIN=claude-sonnet-5-5
TUTOR_MODEL_LIGHT=claude-haiku-5-5   # bộ kiểm tra
TUTOR_MODEL_STRONG=claude-opus-5-5   # lượt khó (D28); tạm dừng khi chi tháng ≥ 45 USD (D29)
# TUTOR_FAKE_MODEL=1                 # chỉ cho e2e trên máy/CI: trả lời mẫu, không gọi API. Không có tác dụng trên Vercel.

# Máy tính đại số (service cas, private). Server only.
CAS_URL=
CAS_SECRET=

# Launcher
LAUNCHER_URL=                     # địa chỉ Study Launcher, vd https://<launcher>.vercel.app
TUTOR_NOTIFY_SECRET=              # cùng giá trị với biến cùng tên bên Launcher (D23)
CRON_SECRET=
